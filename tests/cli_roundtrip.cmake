execute_process(COMMAND "${CLI}" new OUTPUT_FILE "${OUT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot create project JSON")
endif()
execute_process(COMMAND "${CLI}" validate "${OUT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot validate generated JSON")
endif()
execute_process(COMMAND "${CLI}" run "${OUT}" OUTPUT_VARIABLE trace RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT trace MATCHES "7,8000,0,0,25")
  message(FATAL_ERROR "Generated project did not replay the expected trace")
endif()

file(WRITE "${OUT}.invalid" "{}")
execute_process(COMMAND "${CLI}" validate "${OUT}.invalid" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "Invalid project was not rejected")
endif()
execute_process(COMMAND "${CLI}" invalid-command RESULT_VARIABLE result)
if(NOT result EQUAL 2)
  message(FATAL_ERROR "Invalid command was not rejected")
endif()
