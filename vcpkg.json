{
  "name": "industrial-sim",
  "version-semver": "0.2.0",
  "description": "Proprietary offline-first industrial simulation platform",
  "license": "LicenseRef-Proprietary",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [],
  "features": {
    "tests": {
      "description": "Headless tests",
      "dependencies": [
        "gtest"
      ]
    },
    "persistence": {
      "description": "Reserved ZIP package dependencies",
      "dependencies": [
        {
          "name": "minizip-ng",
          "default-features": false,
          "features": [
            "zlib"
          ]
        }
      ]
    },
    "desktop": {
      "description": "Qt Widgets desktop application",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "widgets",
            "opengl"
          ]
        }
      ]
    },
    "visualization": {
      "description": "Reserved dependencies; 3D scene pending",
      "dependencies": [
        {
          "name": "vtk",
          "default-features": false,
          "features": [
            "qt",
            "opengl"
          ]
        }
      ]
    },
    "project": {
      "description": "Versioned project JSON and Draft-07 validation",
      "dependencies": [
        "nlohmann-json",
        "json-schema-validator"
      ]
    }
  }
}
